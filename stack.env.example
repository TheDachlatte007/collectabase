# Local defaults. Copy to stack.env and adjust only the values on the right.
COLLECTABASE_DATA_DIR=./data
COLLECTABASE_UPLOADS_DIR=./uploads
COLLECTABASE_BACKUP_DIR=./backups

# TrueNAS / Portainer example: use absolute paths on a local ZFS dataset.
# Do not point SQLite at an SMB share or a Windows mapped drive.
# COLLECTABASE_DATA_DIR=/mnt/tank/apps/collectabase/data
# COLLECTABASE_UPLOADS_DIR=/mnt/tank/apps/collectabase/uploads
# COLLECTABASE_BACKUP_DIR=/mnt/tank/backups/collectabase
